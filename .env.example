# Database
DATABASE_PORT=3390
#DATABASE_MSSQL_PORT=1450

# KSO
KSO_CI4_PORT=8950
KSO_VUE_PORT=8951
KSO_CENTRIFUGO_PORT=9210
KSO_DB_HOST=db
KSO_DB_NAME=deploy
KSO_DB_USER=root
KSO_DB_PASS=root
# What the stored credentials and the refresh-token cookie are encrypted with. Any 32
# characters will do locally; an installation needs its own, and losing it means the
# credentials in its database cannot be read back.
KSO_ENCRYPTION_KEY=dev-only-key-not-for-any-real-use

# What the scheduler proves itself with when it calls /api/jobby. In a cluster the chart
# generates it; locally anything will do.
KSO_CRON_TOKEN=dev-only-cron-token

# What kso publishes to Centrifugo with. In a cluster the chart generates it; locally anything
# will do.
KSO_CENTRIFUGO_API_KEY=dev-only-centrifugo-api-key
KSO_GKE_AUTH_ENABLED=FALSE
CONFIG_DEFAULTS_CERT_MANAGER_ISSUER_DEFAULT_NAME=letsencrypt-production
CONFIG_DEFAULTS_IMAGE_PULL_SECRET_DEFAULT_NAME=gcr-service-account
CONFIG_EMAIL_HOST=
CONFIG_EMAIL_PORT=
CONFIG_EMAIL_USER=
CONFIG_EMAIL_PASS=
CONFIG_EMAIL_SENDER=

