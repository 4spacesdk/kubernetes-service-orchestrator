{
  "name": "4spacesdk/kubernetes-service-orchestrator",
  "description": "Service Orchestrator for Kubernetes",
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-intl": "*",
    "ext-yaml": "*",
    "ext-zmq": "*",
    "ext-sqlsrv": "*",
    "ext-openssl": "*",
    "ext-sockets": "*",
    "ext-pcntl": "*",

    "hellogerard/jobby": "v3.5.0",
    "codeigniter4/framework": "v4.7.4",
    "4spacesdk/ci4debugtool": "1.0.8",
    "4spacesdk/ci4ormextension": "v1.1.5",
    "4spacesdk/ci4restextension": "v1.0.13",
    "4spacesdk/ci4authextension": "v1.2.5",
    "google/cloud-artifact-registry": "^0.3.7",
    "google/cloud-pubsub": "^2.0",
    "podio-community/podio-php": "7.0.2",
    "knplabs/github-api": "^v3.9.0",
    "robthree/twofactorauth": "^3.0",
    "renoki-co/php-k8s": "3.8.1",
    "phpoption/phpoption": "^1.10",
    "vlucas/phpdotenv": "^5.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "App\\": "tests/",

      "App\\Tests\\Unit\\": "tests/unit/",
      "App\\Tests\\Database\\": "tests/database/",
      "App\\Tests\\Integration\\": "tests/integration/",
      "App\\Tests\\Fakes\\": "tests/_fakes/",

      "Tests\\Support\\": "tests/_support/"
    }
  },
  "scripts": {
    "pre-autoload-dump": [
      "rm -rf vendor/podio-community/podio-php/lib/vendor/kint"
    ]
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
